# Multi-Model LLM Configuration (Ollama + Gemini + OpenAI)
# The backend tries the local Ollama model first, then Gemini, then OpenAI.
# With Ollama running locally no API key is required.
LLM_PROVIDER_ORDER=ollama,gemini,openai

# Local Ollama generation (grounded RAG answers)
# Setup: `ollama serve` then `ollama pull gemma:2b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma:2b
OLLAMA_TIMEOUT=120

# Get your Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6KZKjPeu05rb2v0inre_NQs6bQpaNBGJbKUdvdu-UkX5g
# Model name (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Model name (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# FastAPI Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=True

# Pinecone Vector Database Configuration
# Get your API key from: https://app.pinecone.io/
PINECONE_API_KEY=pcsk_54Fkg1_PeoXk6G9WGrMZCdPiDoSjpZUyWUR31zs9SLRvuR3Z8ZiqrQwzBJtNvjgnsJVbUz
PINECONE_INDEX_NAME=your_index_name_here
PINECONE_NAMESPACE=
# Ollama embedding model (must match what you used to create the embeddings)
# Setup: `ollama pull nomic-embed-text`
PINECONE_EMBEDDING_MODEL=nomic-embed-text
# Metadata field that holds the chunk text
PINECONE_TEXT_FIELD=text
# Host can be copied from the Databricks workspace URL without https://
DATABRICKS_SERVER_HOSTNAME=adb-xxxxxxxxxxxxxxxx.x.azuredatabricks.net
# Use either the SQL warehouse HTTP path or the warehouse ID.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
# DATABRICKS_WAREHOUSE_ID=your_warehouse_id
DATABRICKS_ACCESS_TOKEN=dapi_your_databricks_pat_here
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
DATABRICKS_CACHE_TTL_SECONDS=300
